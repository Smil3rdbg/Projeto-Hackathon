# Dependências do projeto
node_modules/
jspm_packages/
web_modules/

# Saída da compilação do TypeScript (Build)
# Altere 'dist' ou 'build' se o seu 'outDir' no tsconfig.json for diferente
dist/
build/
out/

# Arquivos javascript gerados e mapas (opcional, útil se gerados na raiz)
# Se você compila tudo para a pasta dist, manter os itens abaixo ajuda a evitar sujeira na raiz
*.js.map
*.tsbuildinfo

# Variáveis de ambiente e credenciais (MUITO IMPORTANTE)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# Logs do Node e gerenciadores de pacotes
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Cobertura de testes (Jest, Istanbul, etc.)
coverage/
.nyc_output/

# Cache de ferramentas (TypeScript, Linters, Bundlers)
.eslintcache
.parcel-cache
.eslintcache
.tsbuildinfo
.tsxbuildinfo

# Arquivos do Sistema Operacional
.DS_Store
Thumbs.db
